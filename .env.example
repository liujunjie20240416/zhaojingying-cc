DJANGO_SECRET_KEY="django-insecure-your-secret-key-here"

# Text LLM: used by all non-vision generative tasks (chat, memory, summaries,
# preprocessing, intent classification and RAG helpers). LLM_* is the generic
# name — the base URL selects any OpenAI-compatible provider (DeepSeek, Kimi,
# Qwen, GLM, ...). DEEPSEEK_* below are legacy fallbacks for old setups.
LLM_API_KEY=""
LLM_API_BASE="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-v4-pro"

# Legacy fallback names for the text LLM (kept for existing configurations).
# DEEPSEEK_API_KEY=""
# DEEPSEEK_API_BASE="https://api.deepseek.com/v1"
# DEEPSEEK_MODEL="deepseek-v4-pro"

# Vision chat: GLM image-understanding route, used when the user sends an image.
VISION_LLM_API_KEY=""
VISION_LLM_API_BASE="https://open.bigmodel.cn/api/paas/v4"
VISION_LLM_MODEL="glm-5v-turbo"

# Legacy fallback key for the vision route only; VISION_LLM_API_KEY is canonical.
# GLM_API_KEY=""

# LangSmith: set these to inspect the full LLM data path.
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="zhaojingying-cc"

# DashScope: used by text embeddings, ASR and TTS.
DASHSCOPE_API_KEY=""
DASHSCOPE_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_WSS_URL="wss://dashscope.aliyuncs.com/api-ws/v1/inference"
DASHSCOPE_VOICE_URL="https://dashscope.aliyuncs.com/api/v1/services/audio/tts/customization"

# Context budgets (optional; defaults shown). Override to tune the prompt.
CONTEXT_SOFT_INPUT_TOKENS=32000       # soft cap for the whole input context
CONTEXT_HARD_INPUT_TOKENS=40000       # hard cap, sections are truncated beyond this
CONTEXT_RECENT_HISTORY_TOKENS=6000    # raw recent Online Chat turns kept verbatim
CONTEXT_WORKING_HISTORY_TOKENS=9000   # rolling fold triggers above this
CONTEXT_SUMMARY_TOKENS=1800           # working summary character/token budget
CONTEXT_MEMORY_TOKENS=6000            # retrieved memory-context budget

# Timeouts (seconds; defaults shown). Every external call on the chat path is
# bounded, and the whole turn has its own deadline. Two rules when tuning:
# CHAT_TURN_DEADLINE must stay above the slowest realistic turn (when it fires
# the user gets an error), and the per-call values summing to more than the
# deadline is expected - they cover different failure shapes (one call hanging
# -> degrade that piece; several hanging -> give up early).
# These are per-attempt values: request-path clients set max_retries=1, so the
# real worst case for one call is 2x.
LLM_TIMEOUT_EMBEDDING=8               # DashScope embeddings (up to 9 calls per turn)
LLM_TIMEOUT_SUB=12                    # in-graph helpers: emotion / rewriter / rerank / compress
LLM_TIMEOUT_SUMMARY=40                # summary fold, per batch
LLM_TIMEOUT_REPLY=45                  # the final reply
CHAT_TURN_DEADLINE=90                 # whole-turn cap around app.ainvoke

# Legacy fallback names for DashScope only.
# API_KEY=""
# API_BASE=""
# WSS_URL=""
# VOICE_URL=""
